NODE_ENV=development
PORT=3007
# Secretos: genera cada uno con node -e "console.log(require('crypto').randomBytes(32).toString('hex'))".
# El servicio no arranca si falta alguno, es corto o es un valor de ejemplo.
DATABASE_URL=postgres://card_svc:<DB_PASSWORD_CARD>@localhost:5432/card_db
JWT_SECRET=
STAFF_JWT_SECRET=
ACCOUNT_SERVICE_URL=http://localhost:3002
# AES-256 de los números de tarjeta (64 caracteres hex).
CARD_ENCRYPTION_KEY=
LEDGER_SERVICE_URL=http://localhost:3006
# Clave interna PROPIA de card-service (la aceptan account-service y ledger-service).
INTERNAL_API_KEY=
# Opcional: quién puede disparar run-billing a mano, p. ej. ops:<clave>.
INTERNAL_TRUSTED_KEYS=
