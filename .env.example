NODE_ENV=development
PORT=3007
# Secretos: genera cada uno con node -e "console.log(require('crypto').randomBytes(32).toString('hex'))".
# El servicio no arranca si falta alguno, es corto o es un valor de ejemplo.
DATABASE_URL=postgres://card_svc:<DB_PASSWORD_CARD>@localhost:5432/card_db
JWT_SECRET=
STAFF_JWT_SECRET=
ACCOUNT_SERVICE_URL=http://localhost:3002
# AES-256 de los números de tarjeta (64 caracteres hex).
CARD_ENCRYPTION_KEY=
LEDGER_SERVICE_URL=http://localhost:3006
# Clave interna PROPIA de card-service (la aceptan account-service y ledger-service).
INTERNAL_API_KEY=
# Opcional: quién puede disparar run-billing a mano, p. ej. ops:<clave>.
INTERNAL_TRUSTED_KEYS=
# Clave dinámica (compras y suscripciones).
AUTH_SERVICE_URL=http://localhost:3001
# Eventos de tarjetas y suscripciones (sin RabbitMQ quedan en el outbox).
RABBITMQ_URL=amqp://banklite:<RABBITMQ_PASSWORD>@localhost:5672

# Opcionales (estos son los valores por defecto).
RABBITMQ_EXCHANGE=banklite.events
# Cola donde escucha account.closed (cancela tarjetas y suscripciones del cliente).
RABBITMQ_QUEUE=card-service.account-closed
# Solo pruebas locales: permite mandar la fecha en run-billing. Nunca en producción.
ALLOW_BILLING_DATE_OVERRIDE=false
# Reintentos de las lecturas entre servicios (GET); las escrituras no se reintentan.
HTTP_READ_RETRIES=1
